@ProyectoAppServicios_HostAddress = http://localhost:5298

# ---------------- Autenticación ----------------
# Requiere la clave JWT configurada (una sola vez por máquina):
#   dotnet user-secrets set "Jwt:Clave" "<clave de al menos 32 caracteres>" --project ProyectoAppServicios

### Login (guarda el token en {{login.response.body.token}})
# @name login
POST {{ProyectoAppServicios_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "juan.perez@example.com",
  "contrasenia": "Prueba123!"
}

### Datos del usuario autenticado
GET {{ProyectoAppServicios_HostAddress}}/api/auth/yo
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

### Ejemplo de endpoint protegido: mis propuestas
GET {{ProyectoAppServicios_HostAddress}}/api/propuestas/mias
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

# ---------------- Usuarios ----------------

### Listar usuarios
GET {{ProyectoAppServicios_HostAddress}}/api/usuarios
Accept: application/json

### Obtener usuario por id
GET {{ProyectoAppServicios_HostAddress}}/api/usuarios/1
Accept: application/json

### Registrar usuario
POST {{ProyectoAppServicios_HostAddress}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "email": "juan.perez@example.com",
  "contrasenia": "Prueba123!",
  "telefono": "3465123456",
  "direccion": "Belgrano 1234, Firmat"
}

### Actualizar perfil
PUT {{ProyectoAppServicios_HostAddress}}/api/usuarios/1
Content-Type: application/json

{
  "nombre": "Juan Carlos",
  "apellido": "Pérez",
  "telefono": "3465654321",
  "direccion": "San Martín 500, Firmat"
}

### Baja lógica
DELETE {{ProyectoAppServicios_HostAddress}}/api/usuarios/1

###
# ---------------- Profesionales ----------------

### Listar profesionales
GET {{ProyectoAppServicios_HostAddress}}/api/profesionales
Accept: application/json

### Obtener profesional por id
GET {{ProyectoAppServicios_HostAddress}}/api/profesionales/2
Accept: application/json

### Registrar profesional
POST {{ProyectoAppServicios_HostAddress}}/api/profesionales
Content-Type: application/json

{
  "nombre": "María",
  "apellido": "Gómez",
  "email": "maria.gomez@example.com",
  "contrasenia": "Prueba123!",
  "telefono": "3465111222",
  "direccion": "Italia 800, Firmat",
  "zona": "Firmat",
  "tipoProfesional": "Electricista",
  "nroMatricula": "ELEC-12345"
}

### Actualizar datos del profesional
PUT {{ProyectoAppServicios_HostAddress}}/api/profesionales/2
Content-Type: application/json

{
  "nombre": "María",
  "apellido": "Gómez",
  "telefono": "3465333444",
  "direccion": "Italia 800, Firmat",
  "zona": "Firmat y alrededores",
  "tipoProfesional": "Electricista matriculada"
}

### Actualizar presentación
PATCH {{ProyectoAppServicios_HostAddress}}/api/profesionales/2/presentacion
Content-Type: application/json

{
  "fotoPerfil": "https://example.com/fotos/maria.jpg",
  "comentarioPresentacion": "Electricista con 10 años de experiencia en instalaciones domiciliarias."
}

### Cambiar disponibilidad (true = Disponible, false = Ocupado)
PATCH {{ProyectoAppServicios_HostAddress}}/api/profesionales/2/disponibilidad
Content-Type: application/json

{
  "disponible": false
}

### Baja lógica del profesional
DELETE {{ProyectoAppServicios_HostAddress}}/api/profesionales/2

###
# ---------------- Calificaciones ----------------

### Calificar el encargo 1 (solo el usuario solicitante, encargo finalizado)
POST {{ProyectoAppServicios_HostAddress}}/api/encargos/1/calificacion
Content-Type: application/json

{
  "idUsuario": 1,
  "puntaje": 5,
  "comentario": "Excelente trabajo, muy prolijo y puntual."
}

### Ver la calificación del encargo 1
GET {{ProyectoAppServicios_HostAddress}}/api/encargos/1/calificacion
Accept: application/json

### Ver una calificación por id
GET {{ProyectoAppServicios_HostAddress}}/api/calificaciones/1
Accept: application/json

### Reputación de un profesional (promedio, cantidad y detalle)
GET {{ProyectoAppServicios_HostAddress}}/api/calificaciones/profesional/2
Accept: application/json